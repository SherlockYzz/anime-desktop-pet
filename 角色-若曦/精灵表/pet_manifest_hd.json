        "to": "sleep"
      },
      {
        "from": "sleep",
        "event": "anyInput",
        "to": "idle"
      },
      {
        "from": "waving|jumping|review",
        "event": "animationEnd",
        "to": "idle"
      },
      {
        "from": "*",
        "event": "taskFailed",
        "to": "failed"
      },
      {
        "from": "*",
        "event": "awaitConfirm",
        "to": "waiting"
      },
      {
        "from": "failed|waiting",
        "event": "clear",
        "to": "idle"
      }
    ]
