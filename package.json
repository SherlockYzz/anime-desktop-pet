{
  "name": "megumi-desktop-pet",
  "version": "8.0.0",
  "description": "二次元AI桌宠 v08.00 - 全量十款轻量H5独立微游戏套件(含极意数独与律动共鸣音游) · 鸣潮关卡深度复刻 · 133段CV原声喝彩联动 · 真透明与像素级物理穿透 · 官方考据十阶羁绊与零OOC隔离 · 角色专属手账与长期记忆 · 桌面管家三件套 · 双核Live2D · 广播级原生CV声库",
  "main": "程序主入口.js",
  "scripts": {
    "start": "electron .",
    "dev": "electron . --dev",
    "build": "electron-builder",
    "build:win": "electron-builder --win",
    "build:mac": "electron-builder --mac",
    "build:linux": "electron-builder --linux"
  },
  "keywords": [
    "electron",
    "live2d",
    "ai",
    "desktop-pet",
    "mimo", "sprite-animation", "精灵帧"
  ],
  "author": "Your Name",
  "license": "MIT",
  "devDependencies": {
    "electron": "^28.1.0",
    "electron-builder": "^24.9.1"
  },
  "build": {
    "appId": "com.ai-desktop-pet",
    "productName": "AI桌宠",
    "asar": false,
    "directories": {
      "output": "dist"
    },
    "files": [
      "程序主入口.js",
      "安全桥接.js",
      "核心通用代码/**/*",
      "角色-加藤惠/**/*",
      "角色-蕾姆/**/*",
      "角色-零二/**/*",
      "角色-高木同学/**/*",
      "角色-雪之下雪乃/**/*",
      "角色-若曦/**/*",
      "角色-惠惠/**/*",
      "角色-初音未来/**/*",
      "角色-土间埋/**/*",
      "node_modules/**/*"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "AI桌宠.ico",
      "artifactName": "${productName}-v08.00-安装向导.${ext}"
    },
    "mac": {
      "target": "dmg"
    },
    "linux": {
      "target": "AppImage"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": "always",
      "createStartMenuShortcut": true,
      "shortcutName": "AI桌宠",
      "installerIcon": "AI桌宠.ico",
      "uninstallerIcon": "AI桌宠.ico",
      "installerHeaderIcon": "AI桌宠.ico",
      "runAfterFinish": true
    }
  }
}

