{
  "name": "megumi-desktop-pet",
  "version": "8.1.0",
  "description": "二次元AI桌宠 v8.1.0 - 九大角色全动态驱动(Live2D + 3D VRM预热秒切 + 73帧精灵表) · 90%默认尺寸与气泡自由定位/隐藏 · 桌宠/面板展示分离 · 摸鱼街机10款微游戏两行网格+BGM音乐盒 · 133段CV原声 · 视觉精修与自适应布局",
  "main": "程序主入口.js",
  "scripts": {
    "start": "electron .",
    "dev": "electron . --dev",
    "build": "electron-builder",
    "build:win": "electron-builder --win",
    "build:mac": "electron-builder --mac",
    "build:linux": "electron-builder --linux"
  },
  "keywords": [
    "electron",
    "live2d",
    "ai",
    "desktop-pet",
    "mimo", "sprite-animation", "精灵帧"
  ],
  "author": "SherlockYzz",
  "license": "MIT",
  "devDependencies": {
    "electron": "^28.1.0",
    "electron-builder": "^24.9.1"
  },
  "build": {
    "appId": "com.ai-desktop-pet",
    "productName": "AI桌宠",
    "asar": true,
    "asarUnpack": [
      "AI桌宠.ico",
      "角色-*/图片素材/头像.png"
    ],
    "directories": {
      "output": "dist"
    },
    "files": [
      "程序主入口.js",
      "安全桥接.js",
      "AI桌宠.ico",
      "核心通用代码/**/*",
      "角色-加藤惠/**/*",
      "角色-蕾姆/**/*",
      "角色-零二/**/*",
      "角色-高木同学/**/*",
      "角色-雪之下雪乃/**/*",
      "角色-若曦/**/*",
      "角色-惠惠/**/*",
      "角色-初音未来/**/*",
      "角色-土间埋/**/*"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "AI桌宠.ico",
      "artifactName": "${productName}-v${version}-安装向导.${ext}"
    },
    "mac": {
      "target": "dmg"
    },
    "linux": {
      "target": "AppImage"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": "always",
      "createStartMenuShortcut": true,
      "shortcutName": "AI桌宠",
      "installerIcon": "AI桌宠.ico",
      "uninstallerIcon": "AI桌宠.ico",
      "installerHeaderIcon": "AI桌宠.ico",
      "runAfterFinish": true
    }
  }
}

