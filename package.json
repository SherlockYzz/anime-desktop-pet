{
  "name": "megumi-desktop-pet",
  "version": "7.2.1",
  "description": "二次元AI桌宠 v7.2.1 (重磅发布) - 九大角色全阵容（若曦/加藤惠/蕾姆/惠惠/土间埋/初音未来/雪之下雪乃/高木同学/零二）· 全身超清大舞台 · 动作百宝箱 · 独立快捷键管理器 · 广播级原生CV声库 · 双核Live2D (Cubism 2/4/5) · 全生态LLM接入",
  "main": "程序主入口.js",
  "scripts": {
    "start": "electron .",
    "dev": "electron . --dev",
    "build": "electron-builder",
    "build:win": "electron-builder --win",
    "build:mac": "electron-builder --mac",
    "build:linux": "electron-builder --linux"
  },
  "keywords": [
    "electron",
    "live2d",
    "ai",
    "desktop-pet",
    "mimo", "sprite-animation", "精灵帧"
  ],
  "author": "Your Name",
  "license": "MIT",
  "devDependencies": {
    "electron": "^28.1.0",
    "electron-builder": "^24.9.1"
  },
  "build": {
    "appId": "com.ai-desktop-pet",
    "productName": "AI桌宠",
    "asar": false,
    "directories": {
      "output": "dist"
    },
    "files": [
      "程序主入口.js",
      "安全桥接.js",
      "核心通用代码/**/*",
      "角色-加藤惠/**/*",
      "角色-蕾姆/**/*",
      "角色-零二/**/*",
      "角色-高木同学/**/*",
      "角色-雪之下雪乃/**/*",
      "角色-若曦/**/*",
      "角色-惠惠/**/*",
      "角色-初音未来/**/*",
      "角色-土间埋/**/*",
      "node_modules/**/*"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "AI桌宠.ico",
      "artifactName": "${productName}-v${version}-安装向导.${ext}"
    },
    "mac": {
      "target": "dmg"
    },
    "linux": {
      "target": "AppImage"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": "always",
      "createStartMenuShortcut": true,
      "shortcutName": "AI桌宠",
      "installerIcon": "AI桌宠.ico",
      "uninstallerIcon": "AI桌宠.ico",
      "installerHeaderIcon": "AI桌宠.ico",
      "runAfterFinish": true
    }
  }
}

